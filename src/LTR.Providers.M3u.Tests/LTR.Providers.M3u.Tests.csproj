  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTR.Providers.M3u\LTR.Providers.M3u.csproj" />
  </ItemGroup>

</Project>
