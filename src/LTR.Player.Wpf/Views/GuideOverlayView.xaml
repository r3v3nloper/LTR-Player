<UserControl x:Class="LTR.Player.Wpf.Views.GuideOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LTR.Player.Wpf">

  <!--
    The programme timeline. Hosted inside VideoView.Content by the window rather than beside it: VideoView
    puts a separate native window over the WPF tree, so a sibling element is invisible behind the video.

    The element names below are referenced by bindings within this file, which is why the header, the rows
    and the now-marker have to stay in one XAML namescope together — and therefore in one file.
  -->
  <Border x:Name="GuideRoot"
          DataContext="{Binding Guide}"
          Background="#F21B1E26"
          Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Window navigation. Moving the window is a reload, not a scroll, so it is stated as
         buttons over time rather than as a scrollbar. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <Button Content="◀ 30 min" Command="{Binding MoveEarlierCommand}"
              Background="{StaticResource BorderBrush}" />
      <Button Content="Now" Command="{Binding JumpToNowCommand}" Margin="6,0,0,0" />
      <Button Content="30 min ▶" Command="{Binding MoveLaterCommand}" Margin="6,0,0,0"
              Background="{StaticResource BorderBrush}" />
      <Button Content="Close" Command="{Binding DataContext.ToggleGuideCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
              Margin="18,0,0,0" Background="{StaticResource BorderBrush}" />
    </StackPanel>

    <TextBlock Grid.Row="1"
               Text="{Binding Notice}"
               Style="{StaticResource MutedText}"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Visibility="{Binding Notice, Converter={StaticResource NonEmptyStringToVisibility}}" />

    <!--
      The channel names are outside the horizontal scroller and the timeline is inside it, which is what
      keeps a name in view while its programmes are scrolled. Only the *header* is scrolled directly; every
      row's blocks and the now-marker follow the same offset through a translation, because the rows live in
      a virtualising list that has to keep its own vertical scrolling.

      That single shared offset is also what stops a column heading drifting out of line with the blocks
      beneath it — the property the previous one-scroller-around-everything layout was protecting.
    -->
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel" Style="{StaticResource MutedText}" />

      <!--
        The only real scroller, and it owns the offset the rest of the timeline reads. Its extent is the
        marker strip's width, so the scrollbar appears exactly when four hours do not fit and not otherwise.
      -->
      <ScrollViewer x:Name="TimelineScroller"
                    Grid.Row="0" Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding TimeMarkers}"
                      Width="{Binding Timeline.Width}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas Height="18" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding Position}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:GuideTimeMarker}">
              <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 ItemsSource="{Binding Rows}"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0,2" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:GuideRowViewModel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" />

                <!--
                  Clipped, because the strip inside is four hours wide whatever the cell is and would
                  otherwise be drawn straight over the channel name to its left.
                -->
                <Border Grid.Column="1" ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding Programmes}"
                                HorizontalAlignment="Left"
                                Width="{Binding DataContext.Timeline.Width, ElementName=GuideRoot}">
                    <ItemsControl.RenderTransform>
                      <TranslateTransform
                        X="{Binding HorizontalOffset, ElementName=TimelineScroller,
                                    Converter={StaticResource Negated}}" />
                    </ItemsControl.RenderTransform>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas Height="34" Background="#141720" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:GuideProgrammeViewModel}">
                      <Button Width="{Binding Width}"
                              Height="34"
                              Padding="6,2"
                              HorizontalContentAlignment="Left"
                              Background="{StaticResource BorderBrush}"
                              ToolTip="{Binding Title}"
                              Command="{Binding DataContext.SelectProgrammeCommand,
                                                ElementName=GuideRoot}"
                              CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Times}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>

      <!--
        The current moment, drawn over the rows. Declared after the row list so it lands on top, not
        hit-testable so it does not swallow clicks on the programme underneath it, and clipped and
        translated exactly as a row's blocks are so the line stays on the time it marks.
      -->
      <Border Grid.Row="1" Grid.Column="1"
              ClipToBounds="True"
              IsHitTestVisible="False"
              Visibility="{Binding IsNowVisible, Converter={StaticResource BooleanToVisibility}}">
        <Canvas x:Name="NowMarkerLayer">
          <Canvas.RenderTransform>
            <TranslateTransform
              X="{Binding HorizontalOffset, ElementName=TimelineScroller,
                          Converter={StaticResource Negated}}" />
          </Canvas.RenderTransform>
          <Rectangle Canvas.Left="{Binding NowPosition}"
                     Canvas.Top="0"
                     Width="2"
                     Height="{Binding ActualHeight, ElementName=NowMarkerLayer}"
                     Fill="{StaticResource AccentBrush}" />
        </Canvas>
      </Border>
    </Grid>

    <!-- Detail of the selected programme, which is where a description is long enough to read. -->
    <Border Grid.Row="3"
            Margin="0,10,0,0"
            Padding="12,10"
            Background="{StaticResource SurfaceBrush}"
            Visibility="{Binding SelectedProgramme,
                                 Converter={StaticResource NotNullToVisibility}}">
      <StackPanel DataContext="{Binding SelectedProgramme}">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
          <Run Text="{Binding Times, Mode=OneWay}" />
          <Run Text="{Binding Category, Mode=OneWay}" />
          <Run Text="{Binding EpisodeReference, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding Description}"
                   Style="{StaticResource MutedText}"
                   Margin="0,6,0,0"
                   MaxHeight="90"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
  </Grid>
  </Border>
</UserControl>
