<UserControl x:Class="LTR.Player.Wpf.Views.MovieCatalogueView"
             x:Name="SectionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LTR.Player.Wpf"
             xmlns:views="clr-namespace:LTR.Player.Wpf.Views">

  <!--
    The data context is the shell view model, as it is for every section: the lists live on it and so do the
    commands they trigger.

    Where a data template narrows that context — a row, or the detail pane below — the commands are reached
    through this control by name. `ElementName` rather than a `RelativeSource` ancestor lookup because the
    guide's programme buttons have used it from inside an item template since M3, and a binding that
    resolves to nothing leaves a button that looks enabled and does nothing at all.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <views:CategoryPickerView Grid.Row="0" DataContext="{Binding Movies}" />

    <!-- Delayed, because every keystroke is a database query over tens of thousands of rows. -->
    <TextBox Grid.Row="1"
             Text="{Binding Movies.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
             Margin="0,8,0,8"
             ToolTip="Search the film catalogue" />

    <ListBox Grid.Row="2"
             ItemsSource="{Binding Movies.Movies}"
             SelectedItem="{Binding Movies.SelectedMovie}"
             ItemContainerStyle="{StaticResource CatalogueItem}"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             MouseDoubleClick="OnMovieActivated">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type local:MovieItemViewModel}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
              Fixed size so a row's height does not depend on whether its cover has arrived yet, which
              would make the list jump about as it scrolls.
            -->
            <Border Grid.Column="0"
                    Width="40"
                    Height="60"
                    Margin="0,0,8,0"
                    Background="{StaticResource SurfaceBrush}">
              <Image Source="{Binding CoverUrl, Converter={StaticResource RowCover}}"
                     Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Details}"
                         Style="{StaticResource MutedText}"
                         Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ResumeLabel}"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="12"
                         Margin="0,2,0,0"
                         Visibility="{Binding ResumeLabel,
                                              Converter={StaticResource NonEmptyStringToVisibility}}" />
              <TextBlock Text="Watched"
                         Style="{StaticResource MutedText}"
                         Margin="0,2,0,0"
                         Visibility="{Binding IsWatched, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- The selected film, where a synopsis is long enough to read and the resume point is acted on. -->
    <Border Grid.Row="3"
            Margin="0,10,0,0"
            Padding="10"
            Background="{StaticResource SurfaceBrush}"
            Visibility="{Binding Movies.DetailedMovie, Converter={StaticResource NotNullToVisibility}}">
      <StackPanel DataContext="{Binding Movies.DetailedMovie}">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />

        <TextBlock Text="{Binding Movie.Plot}"
                   Style="{StaticResource MutedText}"
                   Margin="0,6,0,0"
                   MaxHeight="72"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  Command="{Binding DataContext.PlayMovieCommand,
                                    ElementName=SectionRoot}">
            <TextBlock Text="{Binding PlayLabel}" />
          </Button>

          <Button Grid.Column="1"
                  Content="From start"
                  Margin="6,0,0,0"
                  Background="{StaticResource BorderBrush}"
                  Visibility="{Binding HasResumePoint, Converter={StaticResource BooleanToVisibility}}"
                  Command="{Binding DataContext.RestartMovieCommand,
                                    ElementName=SectionRoot}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
