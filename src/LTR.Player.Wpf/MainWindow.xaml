<Window x:Class="LTR.Player.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTR.Player.Wpf.Views"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="LTR-Player"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseMove="OnPointerActivity">

  <!--
    Composition only. Each section is a view of its own, because this file had reached four hundred and
    seventy lines with one list in it (backlog rank 13) and gained three more lists in this milestone.
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Named because fullscreen takes the width to nothing and has to give back whatever the viewer
           had dragged it to, which a binding to a fixed pair of widths could not. -->
      <ColumnDefinition x:Name="SidePanelColumn" Width="360" MinWidth="300" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="14"
          Visibility="{Binding PlayerOverlay.IsFullscreen,
                               Converter={StaticResource InverseBooleanToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="LTR-Player" FontSize="18" FontWeight="SemiBold" />

      <!--
        Source picker, hidden while the add form is up. The two source-management blocks narrow the
        data context once instead of prefixing every binding; the sections below cannot, because they
        bind commands that live on the shell.
      -->
      <Grid Grid.Row="1" Margin="0,14,0,0"
            DataContext="{Binding SourceManagement}"
            Visibility="{Binding DataContext.IsShowingCatalogue,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource BooleanToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding Sources}"
                  SelectedItem="{Binding SelectedSource}"
                  VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
          <Button Content="↻" ToolTip="Refresh the catalogue"
                  Command="{Binding RefreshCommand}" Padding="10,7" />
          <Button Content="+" ToolTip="Add a subscription"
                  Command="{Binding ShowAddSourceCommand}" Padding="10,7" Margin="4,0,0,0" />
          <Button Content="✕" ToolTip="Remove this subscription"
                  Command="{Binding RemoveSourceCommand}" Padding="10,7" Margin="4,0,0,0" />

          <!-- Reaches past the narrowed data context, because settings belong to the shell rather than to
               source management even though the button sits among its own. -->
          <Button Content="⚙" ToolTip="Settings"
                  Command="{Binding DataContext.ToggleSettingsCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                  Padding="10,7" Margin="4,0,0,0"
                  Background="{StaticResource BorderBrush}" />
        </StackPanel>
      </Grid>

      <!--
        The section selector. Films and series are disabled rather than hidden when a subscription does not
        offer them, so their absence reads as a fact about the subscription rather than as a missing feature.
      -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,10"
                  Visibility="{Binding IsShowingCatalogue, Converter={StaticResource BooleanToVisibility}}">
        <RadioButton Content="Live"
                     Style="{StaticResource SectionTab}"
                     IsChecked="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                         ConverterParameter=Live}" />
        <RadioButton Content="Films"
                     Style="{StaticResource SectionTab}"
                     IsEnabled="{Binding Movies.IsAvailable}"
                     ToolTip="Films offered by this subscription"
                     IsChecked="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                         ConverterParameter=Movies}" />
        <RadioButton Content="Series"
                     Style="{StaticResource SectionTab}"
                     IsEnabled="{Binding SeriesCatalogue.IsAvailable}"
                     ToolTip="Series offered by this subscription"
                     IsChecked="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                         ConverterParameter=Series}" />
        <RadioButton Content="Continue"
                     Style="{StaticResource SectionTab}"
                     ToolTip="Films and episodes you are part-way through"
                     IsChecked="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                         ConverterParameter=ContinueWatching}" />
      </StackPanel>

      <!-- Add a source -->
      <views:AddSourceView Grid.Row="3"
                           VerticalAlignment="Top"
                           DataContext="{Binding SourceManagement}"
                           Visibility="{Binding IsAddingSource,
                                                Converter={StaticResource BooleanToVisibility}}" />

      <!-- Settings, in the same space and for the same reason: a form rather than a list. -->
      <views:SettingsView Grid.Row="3"
                          Visibility="{Binding Settings.IsOpen,
                                               Converter={StaticResource BooleanToVisibility}}" />

      <!--
        One section at a time. Each is collapsed rather than unloaded, so switching back does not reload a
        list or lose a scroll position.
      -->
      <Grid Grid.Row="3"
            Visibility="{Binding IsShowingCatalogue, Converter={StaticResource BooleanToVisibility}}">
        <views:LiveChannelsView
            Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                 ConverterParameter=Live}" />
        <views:MovieCatalogueView
            Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                 ConverterParameter=Movies}" />
        <views:SeriesCatalogueView
            Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                 ConverterParameter=Series}" />
        <views:ContinueWatchingView
            Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                 ConverterParameter=ContinueWatching}" />
      </Grid>

      <StackPanel Grid.Row="4" Margin="0,12,0,0">
        <Grid Visibility="{Binding IsShowingCatalogue, Converter={StaticResource BooleanToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Content="Toggle favourite"
                  Command="{Binding Channels.ToggleFavoriteCommand}"
                  HorizontalAlignment="Stretch"
                  Background="{StaticResource BorderBrush}" />

          <Button Grid.Column="1" Content="Guide"
                  Command="{Binding ToggleGuideCommand}"
                  HorizontalAlignment="Stretch"
                  Margin="6,0,0,0"
                  Background="{StaticResource BorderBrush}" />

          <Button Grid.Column="2" Content="⭳"
                  ToolTip="Load the programme guide for this subscription"
                  Command="{Binding ImportGuideCommand}"
                  Margin="6,0,0,0"
                  Background="{StaticResource BorderBrush}" />
        </Grid>

        <!-- Whatever the active section has to say about what it is showing. -->
        <TextBlock Text="{Binding Movies.Notice}"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                        ConverterParameter=Movies}" />

        <TextBlock Text="{Binding SeriesCatalogue.Notice}"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatch},
                                        ConverterParameter=Series}" />

        <TextBlock Text="{Binding Status.Text}"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </StackPanel>
    </Grid>

    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                  Background="{StaticResource BorderBrush}"
                  Visibility="{Binding PlayerOverlay.IsFullscreen,
                                       Converter={StaticResource InverseBooleanToVisibility}}" />

    <!--
      The controls and the timeline live inside VideoView.Content, not beside it. VideoView hosts a separate
      native window over the WPF tree, so any sibling element is simply invisible behind the video. Content
      placed here is rendered by an overlay window that tracks it, and the DataContext is propagated.

      Declaration order is what stacks them: the hint sits behind the controls, and the timeline covers both
      while it is open.
    -->
    <vlc:VideoView x:Name="Video" Grid.Column="2" Background="Black">
      <Grid>
        <TextBlock Text="Pick something to play."
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding NowPlaying, Converter={StaticResource EmptyStringToVisibility}}" />

        <views:PlayerOverlayView />

        <views:GuideOverlayView />
      </Grid>
    </vlc:VideoView>
  </Grid>
</Window>
