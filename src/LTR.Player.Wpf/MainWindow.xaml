<Window x:Class="LTR.Player.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="LTR-Player"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" MinWidth="260" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar: subscription setup until one is configured, then the channel list. -->
    <Grid Grid.Column="0" Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="LTR-Player" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Xtream Codes subscription" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
      </StackPanel>

      <!-- Setup form -->
      <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,18,0,0"
                  Visibility="{Binding HasSource, Converter={StaticResource InverseBooleanToVisibility}}">
        <TextBlock Text="Panel address" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding PanelUrl, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />

        <Button Content="Connect"
                Command="{Binding ConnectCommand}"
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Channel list -->
      <Grid Grid.Row="1" Margin="0,18,0,0"
            Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 Text="{Binding ChannelFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                 Margin="0,0,0,10" />

        <!-- Virtualised and recycling: a subscription can list tens of thousands of channels. -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ChannelView}"
                 SelectedItem="{Binding SelectedChannel}"
                 ItemContainerStyle="{StaticResource ChannelItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 MouseDoubleClick="OnChannelActivated">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <TextBlock Grid.Row="2"
                 Text="{Binding Status}"
                 Style="{StaticResource MutedText}"
                 TextWrapping="Wrap"
                 Margin="0,12,0,0" />
    </Grid>

    <GridSplitter Grid.Column="1"
                  Width="4"
                  HorizontalAlignment="Stretch"
                  Background="{StaticResource BorderBrush}" />

    <!--
      The overlay lives inside VideoView.Content, not beside it. VideoView hosts a separate native
      window over the WPF tree, so any sibling element is simply invisible behind the video. Content
      placed here is rendered by an overlay window that tracks it, and the DataContext is propagated.
    -->
    <vlc:VideoView x:Name="Video" Grid.Column="2" Background="Black">
      <Grid>
        <TextBlock Text="Pick a channel to start playback."
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
          <TextBlock.Visibility>
            <Binding Path="NowPlaying" Converter="{StaticResource EmptyStringToVisibility}" />
          </TextBlock.Visibility>
        </TextBlock>

        <Border VerticalAlignment="Bottom"
                Background="#99000000"
                Padding="14,10"
                Visibility="{Binding NowPlaying, Converter={StaticResource NonEmptyStringToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding NowPlaying}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" />
          </Grid>
        </Border>
      </Grid>
    </vlc:VideoView>
  </Grid>
</Window>
