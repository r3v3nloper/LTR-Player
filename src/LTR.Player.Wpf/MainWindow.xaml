<Window x:Class="LTR.Player.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LTR.Player.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="LTR-Player"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" MinWidth="300" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="LTR-Player" FontSize="18" FontWeight="SemiBold" />

      <!-- Source picker, hidden while the add form is up -->
      <Grid Grid.Row="1" Margin="0,14,0,0"
            Visibility="{Binding IsAddingSource, Converter={StaticResource InverseBooleanToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding Sources}"
                  SelectedItem="{Binding SelectedSource}"
                  VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
          <Button Content="↻" ToolTip="Refresh the catalogue"
                  Command="{Binding RefreshCommand}" Padding="10,7" />
          <Button Content="+" ToolTip="Add a subscription"
                  Command="{Binding ShowAddSourceCommand}" Padding="10,7" Margin="4,0,0,0" />
          <Button Content="✕" ToolTip="Remove this subscription"
                  Command="{Binding RemoveSourceCommand}" Padding="10,7" Margin="4,0,0,0" />
        </StackPanel>
      </Grid>

      <!-- Add a source -->
      <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,16,0,0"
                  Visibility="{Binding IsAddingSource, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="Subscription type" Style="{StaticResource FieldLabel}" />
        <StackPanel Orientation="Horizontal">
          <RadioButton Content="Xtream Codes"
                       Foreground="{StaticResource TextBrush}"
                       IsChecked="{Binding NewSourceProtocol, Converter={StaticResource EnumMatch},
                                           ConverterParameter=Xtream}" />
          <RadioButton Content="M3U playlist"
                       Foreground="{StaticResource TextBrush}"
                       Margin="16,0,0,0"
                       IsChecked="{Binding NewSourceProtocol, Converter={StaticResource EnumMatch},
                                           ConverterParameter=M3uPlaylist}" />
        </StackPanel>

        <!-- Xtream fields -->
        <StackPanel Visibility="{Binding NewSourceProtocol, Converter={StaticResource EnumMatch},
                                         ConverterParameter=Xtream}">
          <TextBlock Text="Panel address" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PanelUrl, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
          <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
        </StackPanel>

        <!-- Playlist fields -->
        <StackPanel Visibility="{Binding NewSourceProtocol, Converter={StaticResource EnumMatch},
                                         ConverterParameter=M3uPlaylist}">
          <TextBlock Text="Playlist address or file" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PlaylistUrl, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="A URL, or a full path to a local .m3u file."
                     Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Button Content="Connect" Command="{Binding ConnectCommand}"
                Margin="0,16,0,0" HorizontalAlignment="Stretch" />
        <Button Content="Cancel" Command="{Binding CancelAddSourceCommand}"
                Margin="0,6,0,0" HorizontalAlignment="Stretch"
                Background="{StaticResource BorderBrush}" />
      </StackPanel>

      <!-- Channel list -->
      <Grid Grid.Row="2" Margin="0,14,0,0"
            Visibility="{Binding IsAddingSource, Converter={StaticResource InverseBooleanToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ComboBox Grid.Row="0"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Grid.Row="1"
                 Text="{Binding ChannelFilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                 Margin="0,8,0,0" />

        <CheckBox Grid.Row="2"
                  Content="Favourites only"
                  Foreground="{StaticResource MutedTextBrush}"
                  Margin="0,10,0,8"
                  IsChecked="{Binding ShowFavoritesOnly}" />

        <!-- Virtualised and recycling: a subscription can list tens of thousands of channels. -->
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding ChannelView}"
                 SelectedItem="{Binding SelectedChannel}"
                 ItemContainerStyle="{StaticResource ChannelItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 MouseDoubleClick="OnChannelActivated">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:ChannelItemViewModel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="★" Foreground="{StaticResource FavoriteBrush}"
                           Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="⟲" ToolTip="Catch-up available"
                           Style="{StaticResource MutedText}"
                           Visibility="{Binding HasArchive, Converter={StaticResource BooleanToVisibility}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <StackPanel Grid.Row="3" Margin="0,12,0,0">
        <Button Content="Toggle favourite"
                Command="{Binding ToggleFavoriteCommand}"
                HorizontalAlignment="Stretch"
                Background="{StaticResource BorderBrush}"
                Visibility="{Binding IsAddingSource, Converter={StaticResource InverseBooleanToVisibility}}" />
        <TextBlock Text="{Binding Status}"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </StackPanel>
    </Grid>

    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                  Background="{StaticResource BorderBrush}" />

    <!--
      The overlay lives inside VideoView.Content, not beside it. VideoView hosts a separate native
      window over the WPF tree, so any sibling element is simply invisible behind the video. Content
      placed here is rendered by an overlay window that tracks it, and the DataContext is propagated.
    -->
    <vlc:VideoView x:Name="Video" Grid.Column="2" Background="Black">
      <Grid>
        <TextBlock Text="Pick a channel to start playback."
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding NowPlaying, Converter={StaticResource EmptyStringToVisibility}}" />

        <Border VerticalAlignment="Bottom"
                Background="#99000000"
                Padding="14,10"
                Visibility="{Binding NowPlaying, Converter={StaticResource NonEmptyStringToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding NowPlaying}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" />
          </Grid>
        </Border>
      </Grid>
    </vlc:VideoView>
  </Grid>
</Window>
