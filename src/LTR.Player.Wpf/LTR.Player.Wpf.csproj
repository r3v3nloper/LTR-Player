  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LibVLCSharp.WPF" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTR.Catalogue\LTR.Catalogue.csproj" />
    <ProjectReference Include="..\LTR.Playback.LibVlc\LTR.Playback.LibVlc.csproj" />
    <ProjectReference Include="..\LTR.Playback\LTR.Playback.csproj" />
    <ProjectReference Include="..\LTR.Providers.M3u\LTR.Providers.M3u.csproj" />
    <ProjectReference Include="..\LTR.Providers\LTR.Providers.csproj" />
    <ProjectReference Include="..\LTR.Security.Dpapi\LTR.Security.Dpapi.csproj" />
    <ProjectReference Include="..\LTR.Providers.Xtream\LTR.Providers.Xtream.csproj" />
  </ItemGroup>

</Project>
