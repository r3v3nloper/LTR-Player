<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:LTR.Player.Wpf">

  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
  <local:StringPresenceToVisibilityConverter x:Key="NonEmptyStringToVisibility" VisibleWhenPresent="True" />
  <local:StringPresenceToVisibilityConverter x:Key="EmptyStringToVisibility" VisibleWhenPresent="False" />
  <local:EnumMatchConverter x:Key="EnumMatch" />
  <local:NullToVisibilityConverter x:Key="NotNullToVisibility" VisibleWhenPresent="True" />
  <local:NullToVisibilityConverter x:Key="NullToVisibility" VisibleWhenPresent="False" />

  <!-- Two decode widths, because a row's thumbnail and the detail pane's poster differ by a factor of
       three and decoding both at the larger size is what makes a scrolled list of covers expensive. -->
  <local:CoverImageConverter x:Key="RowCover" DecodePixelWidth="60" />
  <local:CoverImageConverter x:Key="DetailCover" DecodePixelWidth="200" />

  <!-- A video player is used in a dark room, so the chrome stays dark and low-contrast against the
       picture rather than competing with it. -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#12141A" />
  <SolidColorBrush x:Key="PanelBrush" Color="#1B1E26" />
  <SolidColorBrush x:Key="BorderBrush" Color="#2C313C" />
  <SolidColorBrush x:Key="TextBrush" Color="#E6E8EE" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#8B93A5" />
  <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
  <SolidColorBrush x:Key="FavoriteBrush" Color="#F0C24B" />

  <!--
    Selection is a dark tint with an accent edge, not a fill of the accent colour. A channel row carries
    three levels of text — name, what is on now, what follows — and two of them are deliberately dim; on a
    saturated blue fill the dim ones become unreadable, which is what the accent fill did. Tinting keeps
    every level of the row as legible selected as unselected.
  -->
  <SolidColorBrush x:Key="SelectionBrush" Color="#25344F" />
  <SolidColorBrush x:Key="HoverBrush" Color="#232833" />

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
    <Setter Property="Margin" Value="0,10,0,3" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    A transport button over the picture. Flat and transparent rather than the accent pill used in the
    panel: eight coloured buttons in a row over a film is chrome competing with the picture, which is the
    thing an OSD is supposed to stay out of the way of.
  -->
  <Style x:Key="OverlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.35" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Slider is retemplated for the same reason ComboBox is: the default template paints system-coloured
    chrome, and on the near-black overlay its track is invisible while its thumb is a light lozenge.
    The played portion carries the accent, which is the only thing a seek bar has to communicate.
  -->
  <Style x:Key="BareRepeatButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="2"
                  Height="4"
                  VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <!-- Transparent, not unset: the grid has to be hit-testable across its whole height or the
               bar can only be grabbed on the four pixels of the track itself. -->
          <Grid Background="Transparent" VerticalAlignment="Center">
            <Border Height="4"
                    CornerRadius="2"
                    VerticalAlignment="Center"
                    Background="{StaticResource BorderBrush}" />

            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource BareRepeatButton}"
                              Command="Slider.DecreaseLarge"
                              Background="{StaticResource AccentBrush}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource BareRepeatButton}"
                              Command="Slider.IncreaseLarge"
                              Background="Transparent" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="12" Height="12">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="{StaticResource TextBrush}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ComboBox is fully retemplated rather than restyled. Setting Background alone recolours the closed
    box but not the drop-down, whose chrome comes from the default template's own popup border — and
    with the implicit TextBlock style painting text light, the result is light text on the default white
    popup, which is unreadable.
  -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#232833" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MaxDropDownHeight" Value="420" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="OpenButton"
                          Focusable="False"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Box"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="4">
                    <Path HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Data="M0,0 L4,4 L8,0"
                          Stroke="{StaticResource MutedTextBrush}"
                          StrokeThickness="1.6" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <!--
              Not hit-testable, so clicking the text still opens the drop-down.

              ContentTemplate comes from ItemTemplate, not from SelectionBoxItemTemplate. The latter
              does not resolve in a hand-written template when the display comes from
              DisplayMemberPath, leaving ContentTemplate null — at which point WPF renders ToString(),
              which for a record prints every property. Every ComboBox here therefore declares an
              explicit ItemTemplate rather than a DisplayMemberPath.
            -->
            <ContentPresenter IsHitTestVisible="False"
                              Margin="9,0,28,0"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding ItemTemplate}" />

            <Popup Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Background="{StaticResource PanelBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <!-- CanContentScroll keeps the item panel virtualising, which matters for the 240
                     categories a real subscription declares. -->
                <ScrollViewer CanContentScroll="True">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChannelItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <!-- The accent lives in a left edge rather than in the fill, so the row's dimmer lines stay
               readable while the selection is still unmistakable. -->
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="3,0,0,0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The section selector. Radio buttons rather than a TabControl, because the sections share one pane and a
    TabControl would bring its own header layout, its own content hosting and a second place for the
    selection to live.
  -->
  <Style x:Key="SectionTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A film or series row: cover, then text. Same selection behaviour as a channel row. -->
  <Style x:Key="CatalogueItem" TargetType="ListBoxItem" BasedOn="{StaticResource ChannelItem}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!--
    ToolTip is retemplated for the same reason ComboBox is. The default template paints a light system
    background, and the implicit TextBlock style above paints text light — so every tooltip in the window
    was light grey on near-white and could not be read at all.
  -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="9,6">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
