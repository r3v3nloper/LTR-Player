<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!--
      UseWPF, because the view model binds a CollectionView and that type lives in the WPF assemblies.
      No window is created: these tests exercise command enabling and filtering, which is logic rather
      than presentation.
    -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Linked rather than copied: one test clock and one refusing registry for every project that needs them. -->
  <ItemGroup>
    <Compile Include="../TestSupport/TestClock.cs" Link="TestClock.cs" />
    <Compile
      Include="../TestSupport/NotSupportedProviderRegistry.cs"
      Link="NotSupportedProviderRegistry.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTR.Player.Wpf\LTR.Player.Wpf.csproj" />
  </ItemGroup>

</Project>
