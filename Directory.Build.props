<Project>

  <PropertyGroup>
    <!--
      One version for everything, so a log line, a file property and an issue report all agree. Bump it
      here; nothing else states it.
    -->
    <Version>0.7.0</Version>
    <Product>LTR-Player</Product>
    <Company>LTR-Player</Company>

    <!--
      The copyright covers this application's own code. LibVLC is LGPL-2.1-or-later and dynamically
      linked unmodified, which is what keeps that licence off this notice — see Docs/packaging.md.
    -->
    <Copyright>Copyright © Erik Klein</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      InvariantGlobalization is deliberately NOT enabled. WPF's binding engine resolves the default
      xml:lang through XmlLanguage.GetSpecificCulture, which throws without real culture data — every
      binding in the application fails and the window comes up inert. Beyond that, channel names
      arrive in Cyrillic, Arabic and Greek, so proper casing and collation are needed anyway.
    -->
  </PropertyGroup>

  <PropertyGroup>
    <!--
      CA1873 flags method calls passed as logging arguments. Our logging goes through
      [LoggerMessage] source-generated methods and the costly arguments — credential-stripped URLs —
      are already wrapped in ILogger.IsEnabled checks, but the analyser cannot see the guard through
      the generated wrapper and reports every call site regardless. Suppressed rather than worked
      around, because the alternative is either logging credentials or deleting the diagnostics.
    -->
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>

  <!--
    Abstractions projects intentionally drop the "Abstractions" segment from their namespace
    (LTR.Core.Abstractions -> LTR.Core) so that consumers see one coherent namespace while the
    assembly boundary still separates contracts from implementations.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Abstractions'))">
    <RootNamespace>$(MSBuildProjectName.Replace('.Abstractions', ''))</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      CA1707 forbids underscores in member names. Test methods are named
      Method_Scenario_ExpectedOutcome, which is the convention that makes a failing test report
      readable without opening the file, so the rule is off here and on everywhere else.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
