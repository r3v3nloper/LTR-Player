<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Sources are cleared and re-declared here on purpose: the machine-level config may add
    private feeds (e.g. DevExpress), which breaks Central Package Management with NU1507 and
    makes restore depend on who is building. This project needs nuget.org only.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
